{
	"private": true,
	"name": "yay-root",
	"scripts": {
		"test": "yarn workspace shared build:d && yarn workspace yay test && yarn workspace renderer test",
		"audit": "yarn audit:production && yarn audit:development",
		"audit:production": "yarn npm audit --all --recursive --environment production --no-deprecations",
		"audit:development": "yarn npm audit --all --recursive --severity high --no-deprecations",
		"typecheck": "yarn workspace shared build:d && yarn workspaces foreach -Apt run typecheck",
		"lint": "yarn workspaces foreach -Apt run lint",
		"dev": "yarn workspace yay run dev",
		"watch": "yarn workspace renderer run watch",
		"build": "yarn create-asars && yarn workspaces foreach -Apti run build:d",
		"package": "yarn create-asars && cross-env ENV=PRODUCTION yarn build:p && cross-env ENV=PRODUCTION yarn workspace yay run electron:dist && yarn postpackage",
		"postpackage": "asar-trim ./build/win-unpacked/resources",
		"build:p": "yarn clean-dist && cross-env ENV=PRODUCTION yarn workspaces foreach -Apti run build:p",
		"clean-dist": "yarn run -T tsx scripts/clean-dist.ts",
		"create-asars": "yarn run -T tsx scripts/create-asars.ts",
		"create-installer": "yarn create-online-files-archive && yarn run -T tsx scripts/create-installer.ts",
		"create-online-files-archive": "yarn run -T tsx scripts/create-online-files-archive.ts",
		"create-release": "yarn run -T tsx scripts/create-release.ts",
		"generate-changelog": "yarn run -T tsx scripts/generate-changelog.ts"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/depthbomb/yay.git"
	},
	"bugs": {
		"url": "https://github.com/depthbomb/yay/issues"
	},
	"homepage": "https://github.com/depthbomb/yay#readme",
	"workspaces": [
		"packages/app",
		"packages/renderer",
		"packages/shared",
		"packages/nativelib"
	],
	"devDependencies": {
		"@octokit/rest": "^22.0.1",
		"@types/node": "^24.13.3",
		"asar-trim": "^1.2.3",
		"cross-env": "^10.1.0",
		"dotenv": "^17.4.2",
		"electron-builder": "26.15.7",
		"node-gyp": "^13.0.1",
		"ts-morph": "28.0.0",
		"tsx": "^4.23.12",
		"typescript": "^7.0.2"
	},
	"packageManager": "yarn@4.18.0"
}
