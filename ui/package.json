{
  "private": true,
  "name": "yay-ui",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/**/*.test.ts",
    "test:protocol": "tsx --test ../protocol/*.test.ts ../scripts/ipc/*.test.mjs ../scripts/product/*.test.mjs",
    "generate:ipc": "bun ../scripts/generate_ipc.mjs",
    "generate:product": "bun ../scripts/generate_product.mjs",
    "build": "tsc --noEmit && vite build"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource/momo-trust-display": "5.3.0",
    "@fontsource/momo-trust-sans": "5.3.0",
    "@mdi/js": "7.4.47",
    "@mdi/react": "1.6.1",
    "cva": "1.0.0-beta.8",
    "jotai": "2.20.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "10.1.0",
    "react-router": "8.3.1",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@babel/core": "8.0.1",
    "@eslint/js": "10.0.1",
    "@rolldown/plugin-babel": "0.2.3",
    "@tailwindcss/typography": "0.5.20",
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "10.10.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.6",
    "globals": "17.12.0",
    "postcss": "8.5.28",
    "rolldown": "1.2.7",
    "sass-embedded": "1.104.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "typescript-eslint": "8.69.0",
    "vite": "8.2.2",
    "@types/node": "24.13.3",
    "tsx": "4.23.13"
  }
}
