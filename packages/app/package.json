{
	"private": true,
	"name": "yay",
	"author": "Caprine Logic",
	"main": "dist/app.js",
	"scripts": {
		"test": "tsx --test src/**/*.test.ts",
		"typecheck": "tsc --noEmit",
		"dev": "cross-env NODE_ENV=development bun run build:d && bun run electron:test",
		"build:d": "tsc --noEmit && vite build --mode development && vite build --config vite.preload.config.mts --mode development",
		"build:p": "tsc --noEmit && vite build --mode production && vite build --config vite.preload.config.mts --mode production",
		"electron:test": "electron .",
		"electron:dist": "cross-env NODE_ENV=production bun run electron:win64",
		"electron:win64": "electron-builder --config electron-builder.config.js build -w --x64 --dir --publish=never",
		"lint": "eslint ./src --ext .ts"
	},
	"dependencies": {
		"@depthbomb/common": "^3.3.0",
		"@depthbomb/node-common": "^2.5.0",
		"@formatjs/fast-memoize": "^3.1.7",
		"@hono/node-server": "^2.1.1",
		"@loglayer/transport-log-file-rotation": "^3.3.0",
		"@needle-di/core": "1.2.1",
		"cockatiel": "^4.0.0",
		"hono": "^4.13.7",
		"loglayer": "^9.4.0",
		"nativelib": "workspace:*",
		"semver": "^7.8.5",
		"serialize-error": "^13.0.1",
		"shared": "workspace:*",
		"smol-toml": "1.8.0"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@swc-node/sourcemap-support": "^0.6.1",
		"@types/node": "^24.13.3",
		"@types/semver": "^7.8.0",
		"cross-env": "^10.1.0",
		"electron": "44.2.0",
		"eslint": "^10.10.0",
		"globals": "^17.12.0",
		"terser": "^5.51.2",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.69.0",
		"vite": "^8.2.2"
	}
}
